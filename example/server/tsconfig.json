{
  "compilerOptions": {
    "esModuleInterop": true,
    "allowJs": false,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "noEmit": true,
    "target": "ESNext",
    "skipDefaultLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
