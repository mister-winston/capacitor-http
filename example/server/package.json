{
  "name": "example",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "description": "Example server for @capacitor-community/http with Hapi.js",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "dev-run": "node --import @swc-node/register/esm-register ./src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc && swc src --strip-leading-paths --delete-dir-on-start -d dist",
    "test": "uvu tests"
  },
  "author": "Thomas Vidas <thomas@ionic.io>",
  "license": "MIT",
  "dependencies": {
    "@hapi/hapi": "^21.4.0",
    "@hapi/inert": "^7.1.0",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@swc-node/register": "^1.10.10",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.11.11",
    "@swc/helpers": "^0.5.15",
    "@types/node": "^22.13.0",
    "axios": "^1.8.3",
    "nodemon": "^3.1.9",
    "typescript": "^5.8.2",
    "uvu": "^0.5.2"
  }
}
